# Copy of the settings FoodLink reads. Do not put real values in this file.
# Run `npm run setup` to generate a working .env.local with fresh secrets.

# Required. 32 random bytes, base64. Encrypts personal data at rest.
FOODLINK_DATA_KEY=

# Optional. Enables the language-model half of the hybrid AI.
ANTHROPIC_API_KEY=
# FOODLINK_AI_MODEL=claude-haiku-4-5-20251001
# FOODLINK_AI_MODE=rules

# Optional demo accounts, seeded into an empty database.
DEMO_ORGANIZER_EMAIL=
DEMO_ORGANIZER_PASSWORD=
DEMO_ORGANIZER_TOTP_SECRET=
DEMO_REVIEWER_EMAIL=
DEMO_REVIEWER_PASSWORD=
DEMO_REVIEWER_TOTP_SECRET=
DEMO_NEW_ORGANIZER_EMAIL=
DEMO_NEW_ORGANIZER_PASSWORD=

# Optional deployment settings.
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=
# FOODLINK_TRUST_PROXY=1
